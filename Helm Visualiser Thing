<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Helm Graph H8 - Zero Forcing Visualizer</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    body {
      background-color: #f8fafc;
      color: #0f172a;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 20px;
    }

    h1 {
      font-size: 1.5rem;
      margin-bottom: 8px;
    }

    p.subtitle {
      font-size: 0.9rem;
      color: #64748b;
      margin-bottom: 20px;
    }

    .container {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      padding: 20px;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
      display: flex;
      flex-direction: column;
      align-items: center;
      max-width: 700px;
      width: 100%;
    }

    .controls {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      width: 100%;
      margin-bottom: 16px;
      justify-content: center;
      align-items: center;
    }

    select, button {
      padding: 8px 14px;
      font-size: 0.9rem;
      border-radius: 6px;
      border: 1px solid #cbd5e1;
      background-color: #ffffff;
      cursor: pointer;
      outline: none;
      transition: all 0.2s ease;
    }

    select:focus, button:focus {
      border-color: #2563eb;
      box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.2);
    }

    button {
      background-color: #2563eb;
      color: white;
      border: none;
      font-weight: 600;
    }

    button:hover {
      background-color: #1d4ed8;
    }

    button.secondary {
      background-color: #f1f5f9;
      color: #334155;
      border: 1px solid #cbd5e1;
    }

    button.secondary:hover {
      background-color: #e2e8f0;
    }

    canvas {
      border-radius: 8px;
      background-color: #ffffff;
      border: 1px solid #f1f5f9;
    }

    .status {
      margin-top: 12px;
      font-size: 0.875rem;
      font-weight: 500;
      color: #334155;
    }
  </style>
</head>
<body>

  <div class="container">
    <h1>Helm Graph $H_8$ Zero Forcing Visualizer</h1>
    <p class="subtitle">Center = 0, Cycle = 1–8, Outer Leaves = 9–16</p>

    <div class="controls">
      <select id="setSelect"></select>
      <button id="stepBtn">Step Forcing</button>
      <button id="resetBtn" class="secondary">Reset</button>
    </div>

    <canvas id="canvas" width="550" height="550"></canvas>
    
    <div class="status" id="statusText">Initial Blue Vertices: 6 / 17</div>
  </div>

  <script>
    // --- DATA DEFINITION (36 Zero Forcing Sets) ---
    const rawSets = [
      [1, 3, 12, 13, 15, 16], [1, 7, 10, 11, 13, 14], [1, 10, 11, 13, 14, 15],
      [1, 11, 12, 13, 15, 16], [2, 4, 9, 13, 14, 16], [2, 8, 11, 12, 14, 15],
      [2, 9, 12, 13, 14, 16], [2, 11, 12, 14, 15, 16], [3, 5, 9, 10, 14, 15],
      [3, 9, 10, 13, 14, 15], [3, 9, 12, 13, 15, 16], [4, 6, 10, 11, 15, 16],
      [4, 9, 10, 13, 14, 16], [4, 10, 11, 14, 15, 16], [5, 7, 9, 11, 12, 16],
      [5, 9, 10, 11, 14, 15], [5, 9, 11, 12, 15, 16], [6, 8, 9, 10, 12, 13],
      [6, 9, 10, 12, 13, 16], [6, 10, 11, 12, 15, 16], [7, 9, 10, 11, 13, 14],
      [7, 9, 11, 12, 13, 16], [8, 9, 10, 12, 13, 14], [8, 10, 11, 12, 14, 15],
      [9, 10, 11, 12, 13, 14], [9, 10, 11, 12, 13, 16], [9, 10, 11, 12, 15, 16],
      [9, 10, 11, 13, 14, 15], [9, 10, 11, 14, 15, 16], [9, 10, 12, 13, 14, 16],
      [9, 10, 13, 14, 15, 16], [9, 11, 12, 13, 15, 16], [9, 12, 13, 14, 15, 16],
      [10, 11, 12, 13, 14, 15], [10, 11, 12, 14, 15, 16], [11, 12, 13, 14, 15, 16]
    ];

    // --- GRAPH TOPOLOGY (H8) ---
    const numNodes = 17;
    const adj = Array.from({ length: numNodes }, () => []);

    // 1. Center (0) connects to inner ring (1..8)
    for (let i = 1; i <= 8; i++) {
      adj[0].push(i);
      adj[i].push(0);
    }
    // 2. Inner ring C8 (1..8) cycle connections
    for (let i = 1; i <= 8; i++) {
      let next = (i % 8) + 1;
      adj[i].push(next);
      adj[next].push(i);
    }
    // 3. Pendant leaves (9..16) attached to inner ring (1..8)
    for (let i = 1; i <= 8; i++) {
      let leaf = i + 8;
      adj[i].push(leaf);
      adj[leaf].push(i);
    }

    // --- CANVAS SETUP & COORDINATES ---
    const canvas = document.getElementById('canvas');
    const ctx = canvas.getContext('2d');
    const width = canvas.width;
    const height = canvas.height;
    const centerX = width / 2;
    const centerY = height / 2;
    const nodeRadius = 16;

    const positions = {};
    positions[0] = { x: centerX, y: centerY };

    const rInner = 120;
    const rOuter = 210;

    for (let i = 1; i <= 8; i++) {
      const angle = ((i - 1) * 2 * Math.PI / 8) - Math.PI / 2;
      positions[i] = {
        x: centerX + rInner * Math.cos(angle),
        y: centerY + rInner * Math.sin(angle)
      };
      positions[i + 8] = {
        x: centerX + rOuter * Math.cos(angle),
        y: centerY + rOuter * Math.sin(angle)
      };
    }

    // --- STATE MANAGEMENT ---
    let currentSetIndex = 0;
    let coloredNodes = new Set();
    let forcedSteps = [];

    function initSet(index) {
      currentSetIndex = index;
      coloredNodes = new Set(rawSets[index]);
      forcedSteps = [];
      updateStatus();
      draw();
    }

    function updateStatus() {
      document.getElementById('statusText').innerText = 
        `Colored Vertices: ${coloredNodes.size} / 17 ${coloredNodes.size === 17 ? '(Fully Forced!)' : ''}`;
    }

    // --- ZERO FORCING LOGIC ---
    function stepForcing() {
      let newForces = [];
      
      // Check every colored node to see if it has EXACTLY ONE uncolored neighbor
      for (let u of coloredNodes) {
        let uncoloredNeighbors = adj[u].filter(v => !coloredNodes.has(v));
        if (uncoloredNeighbors.length === 1) {
          let target = uncoloredNeighbors[0];
          newForces.push({ from: u, to: target });
        }
      }

      if (newForces.length > 0) {
        for (let force of newForces) {
          coloredNodes.add(force.to);
        }
        forcedSteps.push(...newForces);
        updateStatus();
        draw();
      } else if (coloredNodes.size < 17) {
        alert("No single-neighbor forcing moves remaining from this state.");
      }
    }

    // --- RENDER FUNCTION ---
    function draw() {
      ctx.clearRect(0, 0, width, height);

      // Draw Edges
      ctx.strokeStyle = '#cbd5e1';
      ctx.lineWidth = 2;
      for (let u = 0; u < numNodes; u++) {
        for (let v of adj[u]) {
          if (u < v) { // Avoid drawing edges twice
            ctx.beginPath();
            ctx.moveTo(positions[u].x, positions[u].y);
            ctx.lineTo(positions[v].x, positions[v].y);
            ctx.stroke();
          }
        }
      }

      // Draw Forcing Direction Arrows
      ctx.strokeStyle = '#ef4444';
      ctx.fillStyle = '#ef4444';
      ctx.lineWidth = 3;
      for (let move of forcedSteps) {
        const from = positions[move.from];
        const to = positions[move.to];
        
        ctx.beginPath();
        ctx.moveTo(from.x, from.y);
        ctx.lineTo(to.x, to.y);
        ctx.stroke();
      }

      // Draw Nodes
      for (let i = 0; i < numNodes; i++) {
        const { x, y } = positions[i];
        const isColored = coloredNodes.has(i);

        ctx.beginPath();
        ctx.arc(x, y, nodeRadius, 0, 2 * Math.PI);

        if (isColored) {
          ctx.fillStyle = '#2563eb'; // Blue
          ctx.fill();
          ctx.strokeStyle = '#1d4ed8';
        } else {
          ctx.fillStyle = '#ffffff'; // White
          ctx.fill();
          ctx.strokeStyle = '#64748b';
        }
        ctx.lineWidth = 2;
        ctx.stroke();

        // Draw Labels
        ctx.fillStyle = isColored ? '#ffffff' : '#0f172a';
        ctx.font = 'bold 12px sans-serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(i.toString(), x, y);
      }
    }

    // --- INTERACTION SETUP ---
    const selectEl = document.getElementById('setSelect');
    rawSets.forEach((s, idx) => {
      const opt = document.createElement('option');
      opt.value = idx;
      opt.innerText = `Set ${idx + 1}: {${s.join(', ')}}`;
      selectEl.appendChild(opt);
    });

    selectEl.addEventListener('change', (e) => initSet(parseInt(e.target.value)));
    document.getElementById('stepBtn').addEventListener('click', stepForcing);
    document.getElementById('resetBtn').addEventListener('click', () => initSet(currentSetIndex));

    // Initial load
    initSet(0);
  </script>
</body>
</html>
